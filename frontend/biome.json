{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"files": { "ignoreUnknown": true },
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedImports": "off",
				"noUnusedVariables": "off"
			},
			"suspicious": {
				"noDebugger": "error",
				"noConsole": "off"
			}
		}
	}
}
