APP_NAME=Global Event Intelligence API
DATABASE_URL=sqlite:///./data/events.db
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GDELT_MAX_RECORDS=50
# Google News RSS is free and requires no API key.

# --- Phase 3: Global Intelligence Assistant (RAG) ---
RAG_ENABLED=true
# Chat/embedding models for grounded answers and retrieval.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
# Bounds answer length/time; raise for longer answers, 0 disables the cap.
OLLAMA_MAX_TOKENS=512
# ollama (semantic) or hashing (offline, no server required).
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_DIMENSIONS=768
# auto (Qdrant when reachable, otherwise SQLite) | sqlite | qdrant
RAG_VECTOR_STORE=auto
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=global_event_intelligence
RAG_TOP_K=8
RAG_MAX_CONTEXT_DOCUMENTS=10
RAG_MIN_RELEVANCE=0.05
RAG_INDEX_ON_STARTUP=true
RAG_INDEX_STARTUP_DELAY_SECONDS=8
# Indexing is throttled so it never competes with live requests or the model
# server: one run at a time, small post-ingestion batch, background top-up.
RAG_INGESTION_INDEX_LIMIT=25
RAG_INDEX_STARTUP_PAUSE_SECONDS=2
RAG_AUTO_INDEX_ON_QUERY=true
RAG_AUTO_INDEX_BACKGROUND=true
RAG_STATUS_CACHE_TTL_SECONDS=5

# Historical intelligence retention (days)
HISTORICAL_RETENTION_DAYS=365
# Only process news published within this many hours of collection.
NEWS_LOOKBACK_HOURS=24
