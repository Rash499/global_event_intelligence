# ======================================================================
# Global Event Intelligence — backend configuration
# Copy to backend/.env and edit. Never commit a real .env file.
# ======================================================================

APP_NAME=Global Event Intelligence API
# development | test | production
# production refuses DEMO_DATA_ENABLED and wildcard CORS at startup.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---------------------------------------------------------
# DATABASE_URL is the single source of truth. Relative paths resolve against
# backend/. Use four slashes for an absolute path:
#   sqlite:////var/lib/gei/events.db
DATABASE_URL=sqlite:///./data/events.db
DB_BUSY_TIMEOUT_MS=30000
DB_WAL_ENABLED=true
DB_BACKUP_BEFORE_MIGRATION=true

# --- API / HTTP -------------------------------------------------------
# Comma separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demonstration events (POST /api/events/seed). Development only.
DEMO_DATA_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=240
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20

# --- Ingestion --------------------------------------------------------
GDELT_MAX_RECORDS=50
# GDELT pacing: at most one request per interval (upstream asks 1 per 5s and
# answers bursts with HTTP 429). Throttled profiles honour Retry-After.
GDELT_REQUEST_INTERVAL_SECONDS=5
GDELT_THROTTLE_MAX_RETRIES=2
GDELT_LANGUAGES=english,spanish,french,german,arabic
GDELT_TIME_WINDOW_HOURS=24
RSS_MAX_ENTRIES_PER_FEED=30
GOOGLE_NEWS_MAX_PER_QUERY=20
GOOGLE_NEWS_LANGUAGE=en-US
GOOGLE_NEWS_COUNTRY=US
INGESTION_MAX_ARTICLES_PER_CYCLE=60
INGESTION_TIMEOUT_SECONDS=25
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=900

# --- Background scheduler --------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_RSS_INTERVAL_SECONDS=900
SCHEDULER_GDELT_INTERVAL_SECONDS=1800
SCHEDULER_GOOGLE_NEWS_INTERVAL_SECONDS=1800
SCHEDULER_USGS_INTERVAL_SECONDS=600
SCHEDULER_EONET_INTERVAL_SECONDS=3600
SCHEDULER_GDACS_INTERVAL_SECONDS=1800
SCHEDULER_RELIEFWEB_INTERVAL_SECONDS=3600
SCHEDULER_WHO_INTERVAL_SECONDS=3600
SCHEDULER_FIRMS_INTERVAL_SECONDS=3600
SCHEDULER_CAP_INTERVAL_SECONDS=600
SCHEDULER_TICK_SECONDS=30

# --- Data providers ---------------------------------------------------
# USGS: no credentials required.
USGS_ENABLED=true
USGS_MIN_MAGNITUDE=2.5
USGS_MAX_FEATURES=200

# NASA EONET v3: public API, no key or registration required.
EONET_ENABLED=true
EONET_DAYS=30
EONET_MAX_EVENTS=200

# GDACS (UN/EC disaster alerts): public REST API, no authentication required.
GDACS_ENABLED=true
GDACS_MAX_EVENTS=100

# ReliefWeb API v2 (v1 decommissioned): since 1 Nov 2025 the `appname` must be
# pre-approved via the request form at https://apidoc.reliefweb.int/ - an
# unapproved appname receives HTTP 403. Free, but approval-gated.
RELIEFWEB_ENABLED=false
RELIEFWEB_APPNAME=
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v2
RELIEFWEB_MAX_RECORDS=50

# WHO Disease Outbreak News: public OData JSON API, no key. (WHO retired
# the old DON RSS feed - its URL returns 404 - so there is no WHO_FEED_URL
# setting any more.)
WHO_ENABLED=true
WHO_MAX_ENTRIES=30

# NASA FIRMS: requires a free MAP_KEY.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_ENABLED=false
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAY_RANGE=1
FIRMS_MAX_DETECTIONS=500
FIRMS_BBOX=-180,-85,180,85

# CAP emergency alerts: comma separated official CAP XML feed URLs.
CAP_FEED_URLS=

# ACLED: licence-controlled, requires a myACLED account and token; access
# level depends on your organisation. Integration is UNVERIFIED against a
# live account. Review ACLED's terms before redistributing any data.
ACLED_ENABLED=false
ACLED_ACCESS_TOKEN=

# --- AI (optional) ----------------------------------------------------
# Deterministic classification is the default. Enable only if Ollama runs.
# COST WARNING: point OLLAMA_URL only at a LOCAL Ollama. Ollama Cloud is a
# paid per-token service and is never used by default.
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Two-stage hybrid classification: rules first, model only when uncertain.
AI_CLASSIFICATION_ENABLED=false
AI_CLASSIFICATION_MIN_CONFIDENCE=0.72
AI_CLASSIFICATION_MAX_PER_CYCLE=10

# --- Assessment -------------------------------------------------------
CONFIDENCE_RECENCY_HALF_LIFE_HOURS=36
CONFIDENCE_MAX_REPORT_AGE_HOURS=168
SYNDICATION_DOMAINS=news.google.com,yahoo.com,msn.com,flipboard.com,smartnews.com

# --- Retention --------------------------------------------------------
# Authoritative value; documented in the README.
HISTORICAL_RETENTION_DAYS=365
RETENTION_PURGE_INTERVAL_SECONDS=3600
RETENTION_ARTICLE_DAYS=365

# --- Geolocation ------------------------------------------------------
# Geolocation is local-gazetteer based; no external geocoding service is
# called. (Removed GEOCODING_*/Nominatim settings: the public Nominatim
# instance prohibits bulk automated use, and no code called it.)

# --- Security ---------------------------------------------------------
# Never enable outside a sandbox: it disables the SSRF private-range block.
SSRF_ALLOW_PRIVATE_HOSTS=false
SSRF_MAX_REDIRECTS=3
SSRF_MAX_RESPONSE_BYTES=1500000
SSRF_TIMEOUT_SECONDS=8

# --- Assistant (RAG) --------------------------------------------------
RAG_ENABLED=true
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_MAX_TOKENS=512
# hashing (offline, default, no server required) or ollama (local models
# only). If ollama is configured but unreachable, hashing is used instead.
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_DIMENSIONS=768
# auto (Qdrant when reachable, otherwise SQLite) | sqlite | qdrant
# COST WARNING: Qdrant is free self-hosted/local. Managed Qdrant Cloud is
# paid above its free tier - a free-only install should keep sqlite or a
# local Qdrant and never point this at a paid cloud cluster unknowingly.
RAG_VECTOR_STORE=auto
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=global_event_intelligence
RAG_TOP_K=8
RAG_MAX_CONTEXT_DOCUMENTS=10
RAG_MIN_RELEVANCE=0.05
RAG_INDEX_ON_STARTUP=true
RAG_INDEX_STARTUP_DELAY_SECONDS=8
RAG_INGESTION_INDEX_LIMIT=25
RAG_INDEX_STARTUP_PAUSE_SECONDS=2
RAG_AUTO_INDEX_ON_QUERY=true
RAG_AUTO_INDEX_BACKGROUND=true
RAG_STATUS_CACHE_TTL_SECONDS=5

# --- Weather ------------------------------------------------------------
# Open-Meteo needs no key/env config. Its free API is licensed for
# NON-COMMERCIAL use only (10k calls/day); commercial use requires a paid
# Open-Meteo subscription. Weather data is CC BY 4.0 (attribution).
