# React / Frontend environment files
# =========================================================

frontend/.env
frontend/.env.local
frontend/.env.*.local

# Keep example env
!frontend/.env.example


# =========================================================
# Backend environment files
# =========================================================

backend/.env
backend/.env.local
backend/.env.*.local

!backend/.env.example


