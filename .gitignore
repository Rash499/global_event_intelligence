# =========================================================
# Global Event Intelligence - Git Ignore
# =========================================================

# ---------------------------------------------------------
# Environment variables / secrets
# ---------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep example environment files
!.env.example


# =========================================================
# Python / FastAPI Backend
# =========================================================

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting caches
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/


# =========================================================
# Database
# =========================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# SQLite temporary files
*.db-journal
*.db-wal
*.db-shm

# Local application data
backend/data/*
backend/storage/*

# Keep directory structure
!backend/data/.gitkeep
!backend/storage/.gitkeep


# =========================================================
# Node.js / React / Vite Frontend
# =========================================================

# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/

# Build cache
.vite/
*.tsbuildinfo

# npm
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager logs
pnpm-debug.log*
bun-debug.log*

# Optional package manager caches
.pnpm-store/


